<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A0B2E"
    android:padding="4dp">

    <!-- Панель смайликов (по умолчанию скрыта) -->
    <HorizontalScrollView
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#2A1B4E"
        android:visibility="gone"
        android:layout_marginBottom="4dp">
        <LinearLayout
            android:id="@+id/emojiContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"/>
    </HorizontalScrollView>

    <!-- Верхняя панель: Настройки, Смайлики, Копировать, Вставить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingRight="8dp">
        <Button android:id="@+id/btnSettings" android:layout_width="40dp" android:layout_height="40dp" android:text="⚙" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnEmojiToggle" android:layout_width="40dp" android:layout_height="40dp" android:text="😊" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnCopy" android:layout_width="40dp" android:layout_height="40dp" android:text="📋" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnPaste" android:layout_width="40dp" android:layout_height="40dp" android:text="📥" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
    </LinearLayout>

    <!-- РЯД 1 (Русский) -->
    <LinearLayout android:id="@+id/rowRu1" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:id="@+id/k_й" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="й" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ц" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ц" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_у" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="у" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_к" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="к" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_е" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="е" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_н" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="н" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_г" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="г" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ш" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ш" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_щ" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="щ" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_з" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="з" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_х" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="х" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ъ" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ъ" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 1 (Английский) -->
    <LinearLayout android:id="@+id/rowEn1" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/e_q" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="q" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_w" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="w" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_e" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="e" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_r" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="r" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="t" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_y" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="y" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_u" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="u" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_i" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="i" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_o" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="o" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_p" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="p" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 2 (Русский) -->
    <LinearLayout android:id="@+id/rowRu2" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:id="@+id/k_ф" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ф" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ы" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ы" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_в" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="в" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_а" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="а" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_п" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="п" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_р" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="р" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_о" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="о" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_л" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="л" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_д" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="д" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ж" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ж" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_э" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="э" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 2 (Английский) -->
    <LinearLayout android:id="@+id/rowEn2" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/e_a" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="a" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_s" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="s" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_d" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="d" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_f" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="f" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_g" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="g" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_h" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="h" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_j" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="j" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_k" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="k" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_l" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="l" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 3 (Русский) -->
    <LinearLayout android:id="@+id/rowRu3" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal">
        <Button android:id="@+id/k_я" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="я" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ч" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ч" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_с" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="с" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_м" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="м" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_и" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="и" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_т" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="т" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ь" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ь" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_б" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="б" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ю" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ю" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 3 (Английский) -->
    <LinearLayout android:id="@+id/rowEn3" android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/e_z" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="z" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_x" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="x" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_c" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="c" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_v" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="v" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_b" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="b" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="n" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
        <Button android:id="@+id/e_m" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="m" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- РЯД 4: Нижняя панель -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:gravity="center_vertical">
        
        <!-- Кнопка цифр (123) -->
        <Button android:id="@+id/btnNumbers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="123" android:textSize="18sp" android:textColor="#FFFFFF" android:backgroundTint="#555555" android:layout_margin="2dp"/>

        <!-- Кнопка смены языка (Глобус) -->
        <Button android:id="@+id/btnLang" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="🌐" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#9C27B0" android:layout_margin="2dp"/>

        <!-- Пробел -->
        <Button android:id="@+id/btnSpace" android:layout_width="0dp" android:layout_weight="3" android:layout_height="match_parent" android:text="" android:backgroundTint="#2A1B4E" android:layout_margin="2dp"/>

        <!-- Кнопка удаления (Корзина) - удаляет по 1 букве, при зажатии - слово -->
        <Button android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:text="⌫" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#F44336" android:layout_margin="2dp"/>

        <!-- Кнопка переноса строки (Enter) -->
        <Button android:id="@+id/btnEnter" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:text="⏎" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#4CAF50" android:layout_margin="2dp"/>
    </LinearLayout>
</LinearLayout>
