<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A0B2E"
    android:padding="4dp">

    <!-- Верхняя панель: Настройки, Смайлики, Копировать, Вставить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingRight="8dp">
        <Button android:id="@+id/btnSettings" android:layout_width="40dp" android:layout_height="40dp" android:text="⚙" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnEmoji" android:layout_width="40dp" android:layout_height="40dp" android:text="😊" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnCopy" android:layout_width="40dp" android:layout_height="40dp" android:text="📋" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
        <Button android:id="@+id/btnPaste" android:layout_width="40dp" android:layout_height="40dp" android:text="📥" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#00000000" android:background="@null" />
    </LinearLayout>

    <!-- Ряд 1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
        <Button android:id="@+id/k_й" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="й" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ц" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ц" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_у" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="у" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_к" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="к" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_е" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="е" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_н" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="н" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_г" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="г" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ш" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ш" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_щ" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="щ" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_з" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="з" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_х" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="х" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ъ" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ъ" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- Ряд 2 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
        <Button android:id="@+id/k_ф" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ф" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ы" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ы" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_в" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="в" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_а" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="а" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_п" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="п" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_р" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="р" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_о" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="о" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_л" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="л" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_д" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="д" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ж" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ж" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_э" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="э" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- Ряд 3 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
        <!-- Кнопка Shift -->
        <Button android:id="@+id/btnShift" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="match_parent" android:text="⬆" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#555555" android:layout_margin="2dp"/>
        
        <Button android:id="@+id/k_я" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="я" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ч" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ч" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_с" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="с" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_м" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="м" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_и" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="и" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_т" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="т" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ь" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ь" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_б" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="б" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        <Button android:id="@+id/k_ю" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="ю" android:textSize="22sp" android:textColor="#FFFFFF" android:backgroundTint="#333333" android:layout_margin="2dp"/>
        
        <!-- Кнопка стереть слово -->
        <Button android:id="@+id/btnDelWord" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="match_parent" android:text="🗑" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#F44336" android:layout_margin="2dp"/>
    </LinearLayout>

    <!-- Нижний ряд: Пробел по центру -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/btnSpace" android:layout_width="0dp" android:layout_weight="4" android:layout_height="match_parent" android:text="ПРОБЕЛ (Удерживай для вкл/выкл перевода)" android:textSize="14sp" android:textColor="#FFFFFF" android:backgroundTint="#673AB7" android:layout_margin="2dp"/>
        <Button android:id="@+id/btnEnter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="⏎" android:textSize="20sp" android:textColor="#FFFFFF" android:backgroundTint="#4CAF50" android:layout_margin="2dp"/>
    </LinearLayout>
</LinearLayout>
